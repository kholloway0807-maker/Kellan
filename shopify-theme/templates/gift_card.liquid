<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t }}</title>
  {{ 'nova.css' | asset_url | stylesheet_tag }}
</head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;">
  <div style="text-align:center;padding:40px;">
    <h1 style="font-size:2rem;font-weight:800;">Your Gift Card</h1>
    <p style="color:#6B6B6B;margin-top:12px;">Amount: {{ gift_card.initial_value | money }}</p>
    <p style="font-family:monospace;font-size:1.5rem;margin-top:24px;letter-spacing:.15em;">{{ gift_card.code | format_code }}</p>
  </div>
</body>
</html>
