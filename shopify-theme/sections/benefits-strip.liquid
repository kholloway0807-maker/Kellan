{%- assign tags = section.settings.tags_raw | newline_to_br | split: '<br />' -%}

<div class="benefits-strip">
  <div class="marquee-wrap">
    <div class="marquee-track">
      {%- for i in (1..4) -%}
        {%- for tag in tags -%}
          {%- assign t = tag | strip -%}
          {%- if t != '' -%}
            <span class="benefit-tag">✦ {{ t }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits Strip",
  "settings": [
    {
      "type": "textarea",
      "id": "tags_raw",
      "label": "Tags (one per line)",
      "default": "Daily Wear\nIncreased Comfort\nEnhanced Fit\nPremium Feel\nLong Lasting\nMade to Last"
    }
  ],
  "presets": [{ "name": "Benefits Strip" }]
}
{% endschema %}
