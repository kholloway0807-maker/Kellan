<section id="shop" class="shop section-pad">
  <div class="container">
    <div class="shop-header">
      <div>
        <span class="eyebrow">The Collection</span>
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      </div>
      <a href="https://novaly.us" target="_blank" rel="noreferrer" class="btn-ghost">
        Full Store
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="products-grid">

      <!-- Product 1: Take The Risk Hoodie -->
      <a href="https://novaly.us/products/nova-take-the-risk-hoodie" class="product-card">
        <div class="product-img-wrap">
          {%- if section.settings.image_hoodie -%}
            <img src="{{ section.settings.image_hoodie | image_url: width: 600 }}" alt="Take The Risk Hoodie" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#E8E6DF;">
              <span style="font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#6B6B6B;">Add Image</span>
            </div>
          {%- endif -%}
          <span class="product-price">$44</span>
        </div>
        <div class="product-info">
          <p class="product-coords">37.7335° N, 119.6376° W</p>
          <h3 class="product-name">Take The Risk Hoodie</h3>
          <p class="product-blurb">Garment-dyed lightweight fleece. 100% ring-spun cotton, worn-in from the first wear.</p>
          <span class="product-cta">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Product 2: Create Your Legacy Crewneck -->
      <a href="https://novaly.us/products/unisex-garment-dyed-sweatshirt" class="product-card">
        <div class="product-img-wrap">
          {%- if section.settings.image_crewneck -%}
            <img src="{{ section.settings.image_crewneck | image_url: width: 600 }}" alt="Create Your Legacy Crewneck" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#E8E6DF;">
              <span style="font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#6B6B6B;">Add Image</span>
            </div>
          {%- endif -%}
          <span class="product-price">$43</span>
        </div>
        <div class="product-info">
          <p class="product-coords">38.8927° N, -77.0230° W</p>
          <h3 class="product-name">Create Your Legacy Crewneck</h3>
          <p class="product-blurb">Vintage-washed, relaxed fit. The soft, structured crewneck for every day.</p>
          <span class="product-cta">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Product 3: Leap Of Faith Tee -->
      <a href="https://novaly.us/products/unisex-garment-dyed-heavyweight-t-shirt-1" class="product-card">
        <div class="product-img-wrap">
          {%- if section.settings.image_tee -%}
            <img src="{{ section.settings.image_tee | image_url: width: 600 }}" alt="Leap Of Faith Tee" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#E8E6DF;">
              <span style="font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#6B6B6B;">Add Image</span>
            </div>
          {%- endif -%}
          <span class="product-price">$28</span>
        </div>
        <div class="product-info">
          <p class="product-coords">27.9881° N, 86.9250° E</p>
          <h3 class="product-name">Leap Of Faith Tee</h3>
          <p class="product-blurb">Heavyweight, structured, breathable. The tee that anchors the collection.</p>
          <span class="product-cta">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Coming Soon — Drop 002 -->
      <div class="product-card coming-soon-card" style="cursor:default;">
        <div class="product-img-wrap" style="background:#0A0A0A;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
          <span style="font-size:11px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.35);">Drop 002</span>
          <span style="font-size:2.5rem;font-weight:900;color:#fff;letter-spacing:-.03em;text-align:center;line-height:1;padding:0 24px;">
            {{ section.settings.drop_name }}
          </span>
          <span style="font-size:11px;font-weight:700;letter-spacing:.25em;text-transform:uppercase;color:rgba(255,255,255,.35);">Coming Soon</span>
        </div>
        <div class="product-info">
          <p class="product-coords">{{ section.settings.drop_coords }}</p>
          <h3 class="product-name">{{ section.settings.drop_title }}</h3>
          <p class="product-blurb">{{ section.settings.drop_blurb }}</p>
          <form style="margin-top:16px;display:flex;gap:8px;">
            <input
              type="email"
              placeholder="Get notified"
              style="flex:1;min-width:0;border:1.5px solid #E0DED7;border-radius:999px;padding:8px 14px;font-size:13px;outline:none;background:#fff;"
            >
            <button
              type="submit"
              class="btn-primary"
              style="padding:8px 16px;font-size:12px;flex-shrink:0;"
            >Notify me</button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    { "type": "text",         "id": "heading",       "label": "Section heading",       "default": "Wear Your Coordinates." },
    { "type": "image_picker", "id": "image_hoodie",  "label": "Hoodie image" },
    { "type": "image_picker", "id": "image_crewneck","label": "Crewneck image" },
    { "type": "image_picker", "id": "image_tee",     "label": "Tee image" },
    {
      "type": "header",
      "content": "Drop 002 — Coming Soon"
    },
    { "type": "text",     "id": "drop_name",   "label": "Drop name",   "default": "DROP 002" },
    { "type": "text",     "id": "drop_coords", "label": "Coordinates", "default": "TBD" },
    { "type": "text",     "id": "drop_title",  "label": "Title",       "default": "Something New Is Coming." },
    { "type": "textarea", "id": "drop_blurb",  "label": "Blurb",       "default": "The next drop is in the works. Sign up and you'll be the first to know." }
  ],
  "presets": [{ "name": "Product Grid" }]
}
{% endschema %}
