<section id="shop" class="shop section-pad">
  <div class="container">
    <div class="shop-header">
      <div>
        <span class="eyebrow">The Collection</span>
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      </div>
      <a href="https://novaly.us" target="_blank" rel="noreferrer" class="btn-ghost">
        Full Store
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="products-grid">

      <!-- Hero card: Take The Risk Hoodie (full width, editorial split) -->
      <a href="/products/nova-take-the-risk-hoodie" class="product-card product-card--hero">
        <div class="product-img-wrap">
          <img src="{{ 'hoodie.jpg' | asset_url }}" alt="Take The Risk Hoodie" loading="eager">
        </div>
        <div class="product-info">
          <span class="product-coords">37.7335° N, 119.6376° W</span>
          <span class="product-price-tag">$44</span>
          <h3 class="product-name">Take The Risk Hoodie</h3>
          <p class="product-blurb">Garment-dyed lightweight fleece. 100% ring-spun cotton, worn-in from the first wear. The piece that started it all.</p>
          <span class="product-cta">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Create Your Legacy Crewneck -->
      <a href="/products/unisex-garment-dyed-sweatshirt" class="product-card">
        <div class="product-img-wrap">
          <img src="{{ 'crewneck.jpg' | asset_url }}" alt="Create Your Legacy Crewneck" loading="lazy">
          <span class="product-price">$43</span>
        </div>
        <div class="product-info">
          <span class="product-coords">38.8927° N, -77.0230° W</span>
          <h3 class="product-name">Create Your Legacy Crewneck</h3>
          <p class="product-blurb">Vintage-washed, relaxed fit. The soft, structured crewneck for every day.</p>
          <span class="product-cta">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Leap Of Faith Tee -->
      <a href="/products/unisex-garment-dyed-heavyweight-t-shirt-1" class="product-card">
        <div class="product-img-wrap">
          <img src="{{ 'tee.jpg' | asset_url }}" alt="Leap Of Faith Tee" loading="lazy">
          <span class="product-price">$28</span>
        </div>
        <div class="product-info">
          <span class="product-coords">27.9881° N, 86.9250° E</span>
          <h3 class="product-name">Leap Of Faith Tee</h3>
          <p class="product-blurb">Heavyweight, structured, breathable. The tee that anchors the collection.</p>
          <span class="product-cta">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Coming Soon — Drop 002 -->
      <div class="product-card coming-soon-card" style="cursor:default;">
        <div class="product-img-wrap" style="aspect-ratio:3/4;background:#0A0A0A;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;">
          <span style="font-size:10px;font-weight:800;letter-spacing:.35em;text-transform:uppercase;color:rgba(255,255,255,.3);">Drop 002</span>
          <span style="font-size:3rem;font-weight:900;color:#fff;letter-spacing:-.04em;text-align:center;line-height:1;padding:0 24px;">{{ section.settings.drop_name }}</span>
          <span style="font-size:10px;font-weight:800;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.3);">Coming Soon</span>
        </div>
        <div class="product-info" style="background:#0A0A0A;border-top:1px solid rgba(255,255,255,.08);">
          <span class="product-coords">{{ section.settings.drop_coords }}</span>
          <h3 class="product-name">{{ section.settings.drop_title }}</h3>
          <p class="product-blurb">{{ section.settings.drop_blurb }}</p>
          <form style="margin-top:20px;display:flex;gap:8px;" onsubmit="this.innerHTML='<span style=\'color:rgba(255,255,255,.6);font-size:13px;\'>You\'re on the list ✦</span>';return false;">
            <input type="email" placeholder="Get notified" required
              style="flex:1;min-width:0;border:1.5px solid rgba(255,255,255,.15);border-radius:999px;padding:9px 16px;font-size:13px;outline:none;background:rgba(255,255,255,.07);color:#fff;">
            <button type="submit" style="display:inline-flex;align-items:center;gap:6px;background:#fff;color:#0A0A0A;border:none;border-radius:999px;padding:9px 18px;font-size:12px;font-weight:800;cursor:pointer;flex-shrink:0;">
              Notify
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Wear Your Coordinates." },
    { "type": "header",   "content": "Drop 002 — Coming Soon" },
    { "type": "text",     "id": "drop_name",   "label": "Drop name",   "default": "DROP 002" },
    { "type": "text",     "id": "drop_coords", "label": "Coordinates", "default": "TBD" },
    { "type": "text",     "id": "drop_title",  "label": "Title",       "default": "Something New Is Coming." },
    { "type": "textarea", "id": "drop_blurb",  "label": "Blurb",       "default": "The next drop is in the works. Sign up and you'll be the first to know." }
  ],
  "presets": [{ "name": "Product Grid" }]
}
{% endschema %}
