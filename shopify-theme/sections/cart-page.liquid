<section class="section-pad">
  <div class="container" style="max-width:680px;">
    <h1 class="section-heading" style="margin-bottom:40px;">Your Cart</h1>

    {%- if cart.item_count == 0 -%}
      <div style="text-align:center;padding:80px 0;">
        <p style="color:var(--muted);font-size:15px;margin-bottom:28px;">Your cart is empty.</p>
        <a href="/" class="btn-primary">Shop the Collection</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div style="display:grid;grid-template-columns:88px 1fr auto;gap:20px;align-items:center;padding:20px 0;border-bottom:1px solid var(--border);">
          <a href="{{ item.url }}">
            <img src="{{ item.image | image_url: width: 176 }}" alt="{{ item.title | escape }}"
              style="width:88px;height:88px;object-fit:contain;border-radius:10px;background:#F5F4F0;padding:6px;">
          </a>
          <div>
            <a href="{{ item.url }}" style="font-weight:700;color:var(--ink);text-decoration:none;font-size:15px;">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}
              <p style="font-size:13px;color:var(--muted);margin-top:3px;">{{ item.variant.title }}</p>
            {%- endunless -%}
            <p style="font-size:13px;color:var(--muted);margin-top:3px;">Qty: {{ item.quantity }}</p>
          </div>
          <div style="text-align:right;">
            <p style="font-weight:800;font-size:15px;">{{ item.line_price | money }}</p>
            <a href="/cart/change?line={{ forloop.index }}&quantity=0"
              style="font-size:12px;color:var(--muted);margin-top:6px;display:inline-block;">Remove</a>
          </div>
        </div>
      {%- endfor -%}

      <div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0 32px;">
        <div>
          <p style="font-size:13px;color:var(--muted);">Subtotal</p>
          <p style="font-size:22px;font-weight:900;color:var(--ink);">{{ cart.total_price | money }}</p>
        </div>
        <form action="/checkout" method="post">
          <button type="submit" class="btn-primary" style="padding:16px 36px;font-size:15px;">
            Checkout
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart Page", "settings": [], "presets": [{ "name": "Cart Page" }] }
{% endschema %}
