{%- assign badges = section.settings.badges_raw | newline_to_br | split: '<br />' -%}

<div class="trust-strip">
  <div class="marquee-wrap">
    <div class="marquee-track">
      {%- for i in (1..3) -%}
        {%- for badge in badges -%}
          {%- assign trimmed = badge | strip -%}
          {%- if trimmed != '' -%}
            <span><i class="trust-icon">✦</i> {{ trimmed }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Strip",
  "settings": [
    {
      "type": "textarea",
      "id": "badges_raw",
      "label": "Badges (one per line)",
      "default": "Optimally Weighted\nGarment-Dyed\nShips Next Day\n100% Ring-Spun Cotton\nEasy Returns\nMade to Last\nFree Shipping $75+\nPremium Fleece"
    }
  ],
  "presets": [{ "name": "Trust Strip" }]
}
{% endschema %}
