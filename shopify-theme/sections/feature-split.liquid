<section class="feature-split section-pad">
  <div class="container">
    <div class="feature-grid">
      {%- if section.settings.image -%}
        <div class="feature-img-wrap">
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="feature-heading">
          {{ section.settings.heading }}
          <span>{{ section.settings.heading_accent }}</span>
        </h2>
        <p class="feature-body">{{ section.settings.body }}</p>

        {%- assign points = section.settings.checklist_raw | newline_to_br | split: '<br />' -%}
        {%- if points.size > 0 -%}
          <ul class="checklist">
            {%- for point in points -%}
              {%- assign pt = point | strip -%}
              {%- if pt != '' -%}
                <li>
                  <span class="check-icon">✓</span>
                  {{ pt }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <a href="{{ section.settings.cta_url }}" class="btn-primary" style="margin-top:32px;">
          {{ section.settings.cta_label }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Split",
  "settings": [
    { "type": "image_picker", "id": "image",          "label": "Product image" },
    { "type": "text",    "id": "eyebrow",              "label": "Eyebrow",       "default": "The Collection" },
    { "type": "text",    "id": "heading",              "label": "Heading line 1","default": "Premium Streetwear" },
    { "type": "text",    "id": "heading_accent",       "label": "Heading line 2 (muted)","default": "Built For The Bold." },
    { "type": "textarea","id": "body",                 "label": "Body text",     "default": "Custom garment-dyed formula designed to give you that perfectly broken-in feel from the very first wear." },
    { "type": "textarea","id": "checklist_raw",        "label": "Checklist items (one per line)", "default": "Heavyweight 400gsm fleece — warm without bulk\nGarment-dyed for rich, lived-in color\nRelaxed oversized fit, holds shape wash after wash" },
    { "type": "url",     "id": "cta_url",              "label": "CTA URL",       "default": "#shop" },
    { "type": "text",    "id": "cta_label",            "label": "CTA label",     "default": "Shop Now" }
  ],
  "presets": [{ "name": "Feature Split" }]
}
{% endschema %}
