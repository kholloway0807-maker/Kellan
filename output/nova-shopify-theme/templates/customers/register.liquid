<section class="section">
  <div class="wrap" style="max-width:480px;">
    <h1 class="section__title" style="margin-bottom:40px;">Create<br>Account</h1>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <label class="pdp__label">First Name</label>
      <input type="text" name="customer[first_name]" class="pdp__select" style="margin-bottom:20px;">
      <label class="pdp__label">Last Name</label>
      <input type="text" name="customer[last_name]" class="pdp__select" style="margin-bottom:20px;">
      <label class="pdp__label">Email</label>
      <input type="email" name="customer[email]" class="pdp__select" style="margin-bottom:20px;">
      <label class="pdp__label">Password</label>
      <input type="password" name="customer[password]" class="pdp__select" style="margin-bottom:24px;">
      <button type="submit" class="btn btn--solid btn--block">Create</button>
    {%- endform -%}
  </div>
</section>
