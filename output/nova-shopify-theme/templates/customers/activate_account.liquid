<section class="section">
  <div class="wrap" style="max-width:480px;">
    <h1 class="section__title" style="margin-bottom:40px;">Activate<br>Account</h1>
    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <label class="pdp__label">Password</label>
      <input type="password" name="customer[password]" class="pdp__select" style="margin-bottom:20px;">
      <label class="pdp__label">Confirm Password</label>
      <input type="password" name="customer[password_confirmation]" class="pdp__select" style="margin-bottom:24px;">
      <button type="submit" class="btn btn--solid btn--block">Activate</button>
      <button type="submit" name="decline" class="btn btn--ghost btn--block" style="margin-top:12px;">Decline</button>
    {%- endform -%}
  </div>
</section>
