{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} &mdash; Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Epilogue:wght@300;400;600&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:40px;">
    <p class="hero__eyebrow" style="justify-content:center;">Wear your mindset</p>
    <h1 class="hero__title" style="font-size:clamp(64px,18vw,200px);">{{ shop.name }}</h1>
    <p style="color:var(--color-muted); margin:24px 0 40px; max-width:420px;">Something bold is coming. Enter the password to take a look.</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">
        <input type="password" name="password" placeholder="PASSWORD"
               style="padding:16px; background:var(--color-surface); color:var(--color-fg); border:1px solid var(--color-rule); letter-spacing:0.1em; text-transform:uppercase;">
        <button type="submit" class="btn btn--solid">Enter</button>
      </div>
    {%- endform -%}
  </main>
</body>
</html>
