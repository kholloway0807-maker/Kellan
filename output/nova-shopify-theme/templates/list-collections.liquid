<section class="coll-head">
  <div class="wrap"><h1 class="coll-head__title">Collections</h1></div>
</section>
<section class="section">
  <div class="wrap">
    <div class="product-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="product-card">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="product-card__body">
            <span class="product-card__name">{{ collection.title }}</span>
            <span class="product-card__price">{{ collection.products_count }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
