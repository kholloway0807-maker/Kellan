<section class="section"><div class="container">
  <h1 class="collection-header__title" data-reveal>{{ blog.title }}</h1>
  <div class="product-grid">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="collection-tile" data-reveal>
        {%- if article.image -%}<img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" width="600" height="600" loading="lazy">{%- endif -%}
        <span class="collection-tile__title">{{ article.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}
