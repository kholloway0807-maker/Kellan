<article class="section"><div class="container container--narrow">
  <h1 class="collection-header__title" data-reveal>{{ article.title }}</h1>
  <p style="opacity:.6" data-reveal>{{ article.published_at | date: '%B %d, %Y' }} · {{ article.author }}</p>
  {%- if article.image -%}<img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" style="border-radius:var(--r);margin:24px 0" data-reveal>{%- endif -%}
  <div class="rte" data-reveal>{{ article.content }}</div>
</div></article>
{% schema %}{ "name": "Article", "settings": [] }{% endschema %}
