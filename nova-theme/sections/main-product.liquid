<section class="section product-page">
  <div class="container product-page__grid">
    <div class="product-gallery" data-reveal>
      {%- if product.featured_media -%}
        <div class="product-gallery__main">
          <img id="ProductMainImage" src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.featured_media.alt | escape | default: product.title }}" width="1100" loading="eager">
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for media in product.media -%}
              <button type="button" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ media | image_url: width: 1100 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 160 }}" alt="" width="160" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="product-info" data-reveal>
      <p class="product-info__vendor">{{ product.vendor }}</p>
      <h1 class="product-info__title">{{ product.title }}</h1>
      <p class="product-info__price" data-price>{{ product.selected_or_first_available_variant.price | money }}</p>

      {% form 'product', product, class: 'product-form', id: 'ProductForm' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option" data-option-index="{{ forloop.index0 }}">
              <label class="product-option__label">{{ option.name }}</label>
              <div class="product-option__values">
                {%- for value in option.values -%}
                  <label class="product-option__pill">
                    <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %} data-option>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <button type="submit" name="add" class="btn btn--primary product-form__submit" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
      {% endform %}

      {%- if product.description != blank -%}
        <div class="product-info__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="application/json" data-product-json>{{ product.variants | json }}</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
