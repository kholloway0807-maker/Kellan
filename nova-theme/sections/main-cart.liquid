<section class="section cart-page">
  <div class="container">
    <h1 class="collection-header__title">Your Cart</h1>
    {%- if cart.item_count > 0 -%}
      {% form 'cart', cart, class: 'cart-form' %}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80">{%- endif -%}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}<p class="cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="cart-item__price">{{ item.final_price | money }}</p>
              </div>
              <div class="cart-item__qty">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
              </div>
              <div class="cart-item__total">{{ item.final_line_price | money }}</div>
              <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="Remove">&times;</a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-footer">
          <div class="cart-footer__totals">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="cart-footer__note">Taxes and shipping calculated at checkout.</p>
          <div class="cart-footer__actions">
            <button type="submit" name="update" class="btn btn--outline">Update</button>
            <button type="submit" name="checkout" class="btn btn--primary">Checkout</button>
          </div>
        </div>
      {% endform %}
    {%- else -%}
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop now</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
