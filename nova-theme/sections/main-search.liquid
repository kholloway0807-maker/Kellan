<section class="section">
  <div class="container">
    <h1 class="collection-header__title">Search</h1>
    {% form 'search', class: 'search-form' %}
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products...">
      <button type="submit" class="btn btn--primary">Search</button>
    {% endform %}
    {%- if search.performed -%}
      <p class="search-results__count">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
