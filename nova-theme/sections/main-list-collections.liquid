<section class="section">
  <div class="container">
    <h1 class="collection-header__title" data-reveal>Collections</h1>
    <div class="product-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-tile" data-reveal>
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}" width="600" height="600" loading="lazy">
          {%- endif -%}
          <span class="collection-tile__title">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
