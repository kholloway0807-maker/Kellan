<section class="section"><div class="container">
  <h1 class="collection-header__title">My Account</h1>
  <p>Welcome, {{ customer.first_name | default: customer.email }}. <a href="{{ routes.account_logout_url }}">Log out</a></p>
  <h2 class="section__title" style="font-size:1.6rem;margin-top:32px">Order history</h2>
  {%- if customer.orders.size > 0 -%}
    <ul>{%- for order in customer.orders -%}<li><a href="{{ order.customer_url }}">{{ order.name }}</a> — {{ order.created_at | date: '%b %d, %Y' }} — {{ order.total_net_amount | money }}</li>{%- endfor -%}</ul>
  {%- else -%}<p>No orders yet.</p>{%- endif -%}
</div></section>
