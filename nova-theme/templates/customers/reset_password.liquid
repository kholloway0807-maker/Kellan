<section class="section"><div class="container container--narrow">
  <h1 class="collection-header__title">Reset password</h1>
  {% form 'reset_customer_password', class: 'newsletter-form' %}
    {{ form.errors | default_errors }}
    <p><input type="password" name="customer[password]" placeholder="New password"></p>
    <p><input type="password" name="customer[password_confirmation]" placeholder="Confirm password"></p>
    <button class="btn btn--primary" type="submit">Reset</button>
  {% endform %}
</div></section>
